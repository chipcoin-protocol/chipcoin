{
  "manifest_version": 3,
  "name": "Chipcoin Wallet",
  "short_name": "Chipcoin",
  "version": "0.1.2",
  "description": "Chipcoin devnet and testnet browser wallet",
  "homepage_url": "https://chipcoinprotocol.com/wallet",
  "icons": {
    "16": "icons/chipcoin-16.png",
    "32": "icons/chipcoin-32.png",
    "48": "icons/chipcoin-48.png",
    "128": "icons/chipcoin-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chipcoin Wallet",
    "default_icon": {
      "16": "icons/chipcoin-16.png",
      "32": "icons/chipcoin-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["https://chipcoinprotocol.com/*"],
      "js": ["assets/content_script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/page_provider.js"],
      "matches": ["https://chipcoinprotocol.com/*"]
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://chipcoinprotocol.com/*"]
}
