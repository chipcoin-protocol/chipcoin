# Compose environment example for a new Mainnet installation.
# This file contains no credentials. Publishing P2P and mining require explicit action.

# Network selected by scripts/setup/wizard.py::_apply_network_defaults.
CHIPCOIN_NETWORK=mainnet
# Compose project name set by scripts/setup/wizard.py::_apply_network_defaults.
COMPOSE_PROJECT_NAME=chipcoin-mainnet

# Isolated from Testnet and Devnet; never import their chainstate or wallets.
CHIPCOIN_RUNTIME_DIR=/var/lib/chipcoin-mainnet-official
CHIPCOIN_RUNTIME_HOST_DIR=/var/lib/chipcoin-mainnet-official
# Mainnet database path from scripts/setup/wizard.py::MAINNET_NODE_DATA_PATH.
NODE_DATA_PATH=/var/lib/chipcoin-mainnet-official/data/node.sqlite3

# Mainnet full-sync mode from scripts/setup/wizard.py::_apply_network_defaults.
NODE_BOOTSTRAP_MODE=full
# Snapshot manifest list is explicitly empty per the wizard's mainnet defaults.
NODE_SNAPSHOT_MANIFEST_URLS=
# Enforced snapshot trust mode from scripts/setup/wizard.py mainnet defaults.
NODE_SNAPSHOT_TRUST_MODE=enforce
# Snapshot file path from scripts/setup/wizard.py::MAINNET_NODE_SNAPSHOT_PATH.
NODE_SNAPSHOT_FILE=/var/lib/chipcoin-mainnet-official/data/node-mainnet.snapshot

# Log level from scripts/setup/wizard.py::DEFAULTS.
NODE_LOG_LEVEL=INFO
# Mainnet P2P bind port from scripts/setup/wizard.py::_apply_network_defaults.
NODE_P2P_BIND_PORT=8333
# Loopback-only host publish default from wizard and docker-compose.yml.
NODE_P2P_PUBLISH_HOST=127.0.0.1
# Mainnet container HTTP port from scripts/setup/wizard.py::_apply_network_defaults.
NODE_HTTP_BIND_PORT=8080
# Mainnet loopback host HTTP port from scripts/setup/wizard.py defaults.
NODE_HTTP_PUBLISH_PORT=8080
# Compose memory guardrail; matches docker-compose.yml default and docs/docker.md.
CHIPCOIN_MEMORY_LIMIT=2g

# Miner log level from scripts/setup/wizard.py::DEFAULTS.
MINER_LOG_LEVEL=INFO
# Mainnet minimum mining interval from scripts/setup/wizard.py defaults.
MINING_MIN_INTERVAL_SECONDS=10.0
# Compose requires a miner wallet path to render; the wizard creates it on request.
# It is only a path placeholder, not a wallet. Create/import a wallet separately.
MINER_WALLET_FILE=/var/lib/chipcoin-mainnet-official/keys/miner-wallet.json
# In-project miner-to-node API URL from mainnet wizard defaults.
MINING_NODE_URLS=http://node:8080

# Mainnet bootstrap seed; outbound discovery only.
NODE_BOOTSTRAP_URL=https://mainnet-bootstrap.chipcoinprotocol.com
